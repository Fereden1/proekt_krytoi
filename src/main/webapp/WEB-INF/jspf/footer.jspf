<footer class="site-footer">
    <div class="container footer-inner">
        <span>&copy; <span id="year"><%= java.time.Year.now() %></span> Дневник расходов. Учебный проект.</span>
        <div class="footer-links">
            <c:choose>
                <c:when test="${not empty sessionScope.userId}">
                    <a href="${ctx}/index">Кабинет</a>
                    <a href="${ctx}/logout">Выйти</a>
                </c:when>
                <c:otherwise>
                    <a href="${ctx}/login">Войти</a>
                    <a href="${ctx}/register">Регистрация</a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</footer>
